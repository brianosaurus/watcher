{
  "permissions": {
    "allow": [
      "Bash(cat deploy/nginx-brian.biz.conf)",
      "Bash(cat deploy/restart.sh)",
      "Bash(node --check static/app.js)",
      "Bash(./deploy/deploy.sh)",
      "Bash(curl -s -o /dev/null -w \"HTTP %{http_code}\\\\n\" https://brian.biz/)",
      "Bash(curl -sI https://brian.biz/)",
      "Bash(curl -s -o /dev/null -w \"api HTTP %{http_code}\\\\n\" https://brian.biz/api/healthz)",
      "Bash(curl -s -o /dev/null -w \"stop endpoint HTTP %{http_code}\\\\n\" -X POST https://brian.biz/api/stop/foo)",
      "Bash(curl -s https://brian.biz/api/status)",
      "Bash(curl -s -o /dev/null -w \"POST /api/start/foo -> %{http_code}\\\\n\" -X POST https://brian.biz/api/start/foo)",
      "Bash(curl -s -o /dev/null -w \"POST /api/stop/foo  -> %{http_code}\\\\n\" -X POST https://brian.biz/api/stop/foo)",
      "Bash(curl -s https://brian.biz/static/app.js)",
      "Bash(awk '/async def _buy_pumpswap|async def _sell_pumpswap/{f=$0; print \"---- \"$0} /timer\\\\.mark|def _buy_pumpswap|def _sell_pumpswap/{if\\($0 ~ /timer.mark/\\) print NR\": \"$0}' trader.py)",
      "Bash(scp memeorator.py timing.py frankfurt:~/memeorator/)",
      "Bash(grep -n \"return summary, series$\\\\|^def _statalyzer_trade_phases\\\\|^# --- memeorator log STATS\" app/main.py)",
      "Bash(npm run *)"
    ]
  }
}
